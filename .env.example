# ─── Agente DevloperEU (LLM + voz) ───────────────────────────────────────────
# Copie para `.env` (dev: raiz do projeto) ou para `devloper-agent.env` (produção: UMA pasta
# acima de public_html) e preencha. NUNCA commitar o ficheiro com valores reais.
# Sem chave → o site continua a funcionar com o fluxo guiado (scriptado).

# Provider: gemini (predefinido) | openai | anthropic | mock (testes, sem custos)
AGENT_PROVIDER=gemini

# Só é preciso a chave do provider escolhido
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional: modelo de chat (predefinições em public/api/agent-brain.json)
#   gemini → gemini-2.5-flash · openai → gpt-4.1-mini · anthropic → claude-haiku-4-5-20251001
AGENT_MODEL=

# Opcional: voz (TTS). gemini → gemini-2.5-flash-preview-tts (voz Kore) · openai → gpt-4o-mini-tts (voz alloy)
AGENT_TTS_MODEL=
AGENT_VOICE=
# off = sem TTS do provider (o browser lê em voz alta com speechSynthesis)
AGENT_TTS=on

# Opcional: origens extra autorizadas (CORS), separadas por vírgula. devloper.eu já está incluído.
AGENT_ALLOWED_ORIGINS=

# Opcional: teto diário de pedidos ao LLM para TODO o site (proteção de custos). Predefinição: 3000
AGENT_DAILY_CAP=

# 1 = desliga o LLM (o site volta ao fluxo guiado)
AGENT_DISABLED=0
