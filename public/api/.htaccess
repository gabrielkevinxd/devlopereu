# Só o agent.php é público. O cérebro (JSON), .env e logs nunca são servidos.
Options -Indexes

<FilesMatch "\.(json|env|log|md|txt)$|^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex"
</IfModule>

# Streaming NDJSON: não comprimir a resposta do agente
<IfModule mod_env.c>
  SetEnvIf Request_URI "^/api/agent\.php" no-gzip dont-vary
</IfModule>
